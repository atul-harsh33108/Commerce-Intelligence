# Copy to .env and fill in. `.env` is gitignored.

# ---------------------------------------------------------------------------------------------
# REQUIRED for the `agent` profile. No default is provided on purpose: a placeholder key produces
# an agent that starts, reports itself healthy, and answers every question with an authentication
# error from a provider - a failure three layers away from its cause.
#
# Free tier is enough: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------------------------
# Where the BAAI/bge-large-en-v1.5 weights live, for the `agent` profile.
#
# `dataquery-agent` already has this exact model (~3.8 GB with every format; TEI only reads
# model.safetensors, config.json and tokenizer.json). Point at it rather than downloading a second
# copy:
#
#   EMBEDDING_MODEL_DIR=D:/project/dataquery-agent/docker/embedding/bge-large-en-v1.5
#
# Leave it unset to use ./agent/models/bge-large-en-v1.5, which keeps this repository
# self-contained for anyone who does not have that copy.
# ---------------------------------------------------------------------------------------------
# EMBEDDING_MODEL_DIR=

# ---------------------------------------------------------------------------------------------
# Optional. Production uses ${ENV_VAR} placeholders that the config server passes through
# unresolved, so these are what a real deployment supplies from a Kubernetes Secret.
# ---------------------------------------------------------------------------------------------
# JWT_SECRET=

# Makes every simulated card payment decline, which is how the saga's compensating transaction is
# demonstrated end to end rather than only in a unit test. See scripts/saga_demo.py --expect-fail.
# PAYMENT_FAILURE_RATE=1.0
