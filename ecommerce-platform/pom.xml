<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.ecommerce</groupId>
    <artifactId>ecommerce-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ecommerce-platform</name>
    <description>E-commerce microservices: the transactional core, split by bounded context</description>

    <!--
      An aggregator, not a shared-code module.

      It builds every service with one command and pins versions in one place. It publishes no
      classes: services deliberately do not share a jar of "common" entities, DTOs or events. A
      shared domain library is how a set of microservices quietly becomes a distributed monolith -
      one team's change to a shared class forces every other service to rebuild and redeploy, which
      is exactly the coupling the split was meant to remove. Carried over from the bookstore
      capstone's D12 and re-argued in docs/decisions.md (D2).
    -->
    <!--
      Modules are added as the steps that need them arrive, not all at once. The build order is
      Maven's own reactor calculation, not this list's order.
    -->
    <modules>
        <!-- Step 0. Infrastructure first: every other service refuses to start without config. -->
        <module>config-server</module>
        <module>discovery-server</module>
        <module>api-gateway</module>

        <!-- Step 1. The walking skeleton: one service, end to end, on a real database. -->
        <module>catalog-service</module>

        <!-- Step 3. The rest of the bounded contexts, each with its own database. -->
        <module>user-service</module>
        <module>inventory-service</module>
        <module>order-service</module>
        <module>payment-service</module>

        <!-- Step 7. A read model fed by events; owns no source of truth. -->
        <module>search-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!--
          Release train aligned to Boot 3.5.x. Boot 4.x is out but the 2025.0.x train is the last one
          that targets 3.5, and mixing them produces NoSuchMethodError at runtime rather than a
          resolution failure at build time. Same reasoning as the capstone's D1.
        -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- Not managed by Boot or by the release train, so pinned here rather than left to chance. -->
        <jjwt.version>0.13.0</jjwt.version>
        <spring-security-rsa.version>1.1.5</spring-security-rsa.version>
        <!--
          Boot 3.5 manages testcontainers-bom, but not the Kafka/Elasticsearch modules' transitive
          expectations. Left to Boot; recorded here so the next person knows it was checked.
        -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-rsa</artifactId>
                <version>${spring-security-rsa.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
